// ───────────────────────── Payment & Finance (spec §4.7) ─────────────────────────
// Principles (docs/PAYMENT.md):
//   * The system never issues official receipts – กองคลัง does. We only record receipt numbers.
//   * Amounts are computed on the backend from a fee-rate snapshot taken when the order is created.
//   * Money columns are immutable once written (DB triggers); corrections are new ledger rows.
//   * Order / payment / receipt / batch statuses are separate state machines.

enum PaymentOrderStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  EXPIRED
  CANCELLED
  WAIVED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentStatus {
  SUBMITTED
  VERIFIED
  REJECTED
  VOIDED
}

enum PaymentChannel {
  TRANSFER
  ONSITE
}

enum LedgerEntryType {
  CHARGE // + amount owed
  PAYMENT // − verified payment
  WAIVER // − fee waived (with reason)
  REVERSAL // reverses an earlier entry (sign opposite to the original)
  REFUND // + money returned to the payer
}

enum FinanceBatchStatus {
  DRAFT
  SUBMITTED
  RETURNED
  RECEIVED
  RECEIPTS_ISSUED
  CLOSED
}

/// FIN-9: who the official receipt is made out to.
enum BillingType {
  INDIVIDUAL // ในนามบุคคล (ชื่อผู้ชำระ)
  JURISTIC // ในนามนิติบุคคล / หน่วยงาน (ต้องมีเลขประจำตัวผู้เสียภาษี)
}

/// Bank-statement line ↔ payment matching (กระทบยอด).
enum StatementMatchStatus {
  UNMATCHED
  AUTO // matched by the system (same amount, transfer time within the tolerance)
  MANUAL // matched by an officer
  IGNORED // not a registration payment (note required)
}

enum ReceiptStatus {
  ISSUED
  DELIVERED
  VOIDED
  RETURNED_UNUSED
}

/// University receiving account (FIN-4: central or per organization). organization_id null = central.
model BankAccount {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  bankName       String   @map("bank_name") @db.VarChar(150)
  branch         String?  @db.VarChar(150)
  accountNo      String   @map("account_no") @db.VarChar(20)
  accountName    String   @map("account_name") @db.VarChar(300)
  /// PromptPay target (13-digit tax/citizen id, e-wallet, or phone). null = no QR, transfer details only.
  promptPayId    String?  @map("promptpay_id") @db.VarChar(20)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  events         Event[]
  statements     BankStatement[]
  statementLines BankStatementLine[]

  @@index([organizationId])
  @@map("bank_accounts")
}

/// รหัสรายได้ / แหล่งเงิน (FIN-5).
model IncomeCode {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(30)
  nameTh    String   @map("name_th") @db.VarChar(300)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  events Event[]

  @@map("income_codes")
}

/// Registration fee per participant type and time window (early bird / regular / late).
/// participant_type_id null = applies to every participant type.
model EventFeeRate {
  id                String    @id @default(uuid(7)) @db.Uuid
  eventId           String    @map("event_id") @db.Uuid
  participantTypeId String?   @map("participant_type_id") @db.Uuid
  nameTh            String    @map("name_th") @db.VarChar(200)
  amount            Decimal   @db.Decimal(12, 2)
  validFrom         DateTime? @map("valid_from") @db.Timestamptz(6)
  validUntil        DateTime? @map("valid_until") @db.Timestamptz(6)
  sortOrder         Int       @default(0) @map("sort_order")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantType ParticipantType?   @relation(fields: [participantTypeId], references: [id], onDelete: Restrict)
  orders          PaymentOrder[]
  orderLines      PaymentOrderLine[]

  @@index([eventId, isActive])
  @@map("event_fee_rates")
}

/// ใบแจ้งชำระเงิน. One active order per registration (partial unique index in SQL).
model PaymentOrder {
  id                  String             @id @default(uuid(7)) @db.Uuid
  orderNo             String             @unique @map("order_no") @db.VarChar(30) // INV-2570-000001
  eventId             String             @map("event_id") @db.Uuid
  registrationId      String?            @map("registration_id") @db.Uuid
  /// Combined order of a registration group (P3). Exactly one of registration_id / group_id (CHECK).
  groupId             String?            @map("group_id") @db.Uuid
  payerName           String             @map("payer_name") @db.VarChar(300)
  payerEmail          String             @map("payer_email") @db.VarChar(254)
  /// Immutable (trigger). Snapshot of the applicable fee at creation time.
  amount              Decimal            @db.Decimal(12, 2)
  feeRateId           String?            @map("fee_rate_id") @db.Uuid
  feeSnapshot         Json               @map("fee_snapshot")
  /// Receiving account + income code as they were when the order was issued.
  bankAccountSnapshot Json?              @map("bank_account_snapshot")
  incomeCode          String?            @map("income_code") @db.VarChar(30)
  status              PaymentOrderStatus @default(UNPAID)
  /// FIN-9 receipt addressee. INDIVIDUAL → payer_name; JURISTIC → name + 13-digit tax id + branch.
  billingType         BillingType        @default(INDIVIDUAL) @map("billing_type")
  billingName         String?            @map("billing_name") @db.VarChar(300)
  billingTaxId        String?            @map("billing_tax_id") @db.Char(13)
  /// "สำนักงานใหญ่" or a 5-digit branch number.
  billingBranch       String?            @map("billing_branch") @db.VarChar(100)
  billingAddress      String?            @map("billing_address") @db.VarChar(1000)
  dueAt               DateTime           @map("due_at") @db.Timestamptz(6)
  paidAt              DateTime?          @map("paid_at") @db.Timestamptz(6)
  closedAt            DateTime?          @map("closed_at") @db.Timestamptz(6)
  closeReason         String?            @map("close_reason") @db.VarChar(1000)
  version             Int                @default(1)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  event        Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration Registration?        @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  group        RegistrationGroup?   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  feeRate      EventFeeRate?        @relation(fields: [feeRateId], references: [id], onDelete: SetNull)
  lines        PaymentOrderLine[]
  payments     Payment[]
  ledger       PaymentLedgerEntry[]
  refunds      Refund[]

  @@index([eventId, status])
  @@index([registrationId])
  @@index([groupId])
  @@index([status, dueAt])
  @@map("payment_orders")
}

/// A payment attempt (transfer slip or on-site cash). Verified payments go into a finance batch.
model Payment {
  id                String         @id @default(uuid(7)) @db.Uuid
  paymentNo         String         @unique @map("payment_no") @db.VarChar(30) // PAY-2570-000001
  orderId           String         @map("order_id") @db.Uuid
  channel           PaymentChannel
  /// Immutable (trigger).
  amount            Decimal        @db.Decimal(12, 2)
  status            PaymentStatus  @default(SUBMITTED)
  slipFileId        String?        @map("slip_file_id") @db.Uuid
  /// SHA-256 of the slip bytes – the same slip cannot back two live payments (partial unique in SQL).
  slipSha256        String?        @map("slip_sha256") @db.Char(64)
  transferredAt     DateTime?      @map("transferred_at") @db.Timestamptz(6)
  payerNote         String?        @map("payer_note") @db.VarChar(500)
  submittedById     String?        @map("submitted_by_id") @db.Uuid
  submittedAt       DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(6)
  verifiedById      String?        @map("verified_by_id") @db.Uuid
  /// On-site cash: the cashier session that received it.
  cashierSessionId  String?        @map("cashier_session_id") @db.Uuid
  /// FIN-12: recorded while the cash point was offline and synced later = when the cash was taken.
  capturedOfflineAt DateTime?      @map("captured_offline_at") @db.Timestamptz(6)
  verifiedAt        DateTime?      @map("verified_at") @db.Timestamptz(6)
  rejectReason      String?        @map("reject_reason") @db.VarChar(1000)
  voidedById        String?        @map("voided_by_id") @db.Uuid
  voidedAt          DateTime?      @map("voided_at") @db.Timestamptz(6)
  voidReason        String?        @map("void_reason") @db.VarChar(1000)
  version           Int            @default(1)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  order          PaymentOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  slipFile       File?                @relation("PaymentSlip", fields: [slipFileId], references: [id], onDelete: Restrict)
  submittedBy    User?                @relation("PaymentSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  verifiedBy     User?                @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  cashierSession CashierSession?      @relation(fields: [cashierSessionId], references: [id], onDelete: Restrict)
  ledger         PaymentLedgerEntry[]
  batchItems     FinanceBatchItem[]
  receipts       ReceiptRecord[]
  statementLines BankStatementLine[]

  @@index([orderId])
  @@index([status, submittedAt])
  @@map("payments")
}

/// Append-only money ledger (trigger blocks UPDATE/DELETE). Balance of an order = SUM(amount).
model PaymentLedgerEntry {
  id          String          @id @default(uuid(7)) @db.Uuid
  orderId     String          @map("order_id") @db.Uuid
  paymentId   String?         @map("payment_id") @db.Uuid
  entryType   LedgerEntryType @map("entry_type")
  amount      Decimal         @db.Decimal(12, 2)
  reason      String?         @db.VarChar(1000)
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  order     PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment   Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdBy User?        @relation("LedgerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("payment_ledger_entries")
}

/// ชุดนำส่งกองคลัง – verified payments of one event, prepared by the organizer's finance officer.
model FinanceBatch {
  id             String             @id @default(uuid(7)) @db.Uuid
  batchNo        String             @unique @map("batch_no") @db.VarChar(30) // FB-2570-000001
  organizationId String             @map("organization_id") @db.Uuid
  eventId        String             @map("event_id") @db.Uuid
  status         FinanceBatchStatus @default(DRAFT)
  /// Totals are fixed when the batch is created (items cannot change afterwards).
  totalAmount    Decimal            @map("total_amount") @db.Decimal(12, 2)
  itemCount      Int                @map("item_count")
  /// Report snapshot frozen at submission (what กองคลัง received).
  snapshot       Json?
  note           String?            @db.VarChar(1000)
  createdById    String             @map("created_by_id") @db.Uuid
  submittedById  String?            @map("submitted_by_id") @db.Uuid
  submittedAt    DateTime?          @map("submitted_at") @db.Timestamptz(6)
  receivedById   String?            @map("received_by_id") @db.Uuid
  receivedAt     DateTime?          @map("received_at") @db.Timestamptz(6)
  returnedById   String?            @map("returned_by_id") @db.Uuid
  returnedAt     DateTime?          @map("returned_at") @db.Timestamptz(6)
  returnReason   String?            @map("return_reason") @db.VarChar(1000)
  version        Int                @default(1)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdBy    User               @relation("BatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  receivedBy   User?              @relation("BatchReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  items        FinanceBatchItem[]
  receipts     ReceiptRecord[]

  @@index([organizationId, status])
  @@index([eventId])
  @@index([status, createdAt])
  @@map("finance_batches")
}

/// A payment may belong to only one live batch (partial unique on payment_id WHERE is_active).
model FinanceBatchItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  batchId   String   @map("batch_id") @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  batch   FinanceBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  payment Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@map("finance_batch_items")
}

/// Official receipt numbers issued by กองคลัง and recorded here.
/// FIN-2: shown as "<fiscalYear>/<receiptNo>" e.g. 2569/0001 — no book number; voided numbers are never reused.
model ReceiptRecord {
  id           String        @id @default(uuid(7)) @db.Uuid
  paymentId    String        @map("payment_id") @db.Uuid
  batchId      String?       @map("batch_id") @db.Uuid
  fiscalYear   Int           @map("fiscal_year")
  /// Zero-padded running number within the fiscal year (normalizeReceiptNo).
  receiptNo    String        @map("receipt_no") @db.VarChar(30)
  issuedAt     DateTime      @map("issued_at") @db.Date
  amount       Decimal       @db.Decimal(12, 2)
  status       ReceiptStatus @default(ISSUED)
  recordedById String        @map("recorded_by_id") @db.Uuid
  voidedAt     DateTime?     @map("voided_at") @db.Timestamptz(6)
  voidReason   String?       @map("void_reason") @db.VarChar(1000)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment    Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  batch      FinanceBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  recordedBy User          @relation("ReceiptRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([fiscalYear, receiptNo])
  @@index([paymentId])
  @@index([batchId])
  @@map("receipt_records")
}

enum CashierSessionStatus {
  OPEN // รับเงินอยู่
  CLOSED // ปิดกะ นับเงินแล้ว
  REMITTED // นำส่งเงินสดแล้ว (มีเลขที่ใบนำส่ง)
  CONFIRMED // การเงินหน่วยงานยืนยันยอด → รายการเข้าชุดนำส่งได้
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

/// กะรับเงินหน้างาน. One OPEN session per cashier per event (partial unique in SQL).
model CashierSession {
  id             String               @id @default(uuid(7)) @db.Uuid
  sessionNo      String               @unique @map("session_no") @db.VarChar(30) // CS-2570-000001
  eventId        String               @map("event_id") @db.Uuid
  cashierId      String               @map("cashier_id") @db.Uuid
  status         CashierSessionStatus @default(OPEN)
  openingFloat   Decimal              @default(0) @map("opening_float") @db.Decimal(12, 2)
  openedAt       DateTime             @default(now()) @map("opened_at") @db.Timestamptz(6)
  /// Frozen at close: SUM of live ONSITE payments in the session.
  expectedAmount Decimal?             @map("expected_amount") @db.Decimal(12, 2)
  /// Cash counted by the cashier (excluding the opening float).
  countedAmount  Decimal?             @map("counted_amount") @db.Decimal(12, 2)
  closedAt       DateTime?            @map("closed_at") @db.Timestamptz(6)
  closeNote      String?              @map("close_note") @db.VarChar(1000)
  remittanceNo   String?              @map("remittance_no") @db.VarChar(50) // เลขที่ใบนำส่งเงิน
  remittedAt     DateTime?            @map("remitted_at") @db.Timestamptz(6)
  confirmedById  String?              @map("confirmed_by_id") @db.Uuid
  confirmedAt    DateTime?            @map("confirmed_at") @db.Timestamptz(6)
  version        Int                  @default(1)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  event       Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  cashier     User      @relation("CashierSessionCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  confirmedBy User?     @relation("CashierSessionConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  payments    Payment[]

  @@index([eventId, status])
  @@index([cashierId, status])
  @@map("cashier_sessions")
}

/// คำขอคืนเงิน. Requester ≠ approver (SoD). Payee account number is AES-256-GCM encrypted.
model Refund {
  id              String       @id @default(uuid(7)) @db.Uuid
  refundNo        String       @unique @map("refund_no") @db.VarChar(30) // RF-2570-000001
  orderId         String       @map("order_id") @db.Uuid
  /// Immutable (trigger).
  amount          Decimal      @db.Decimal(12, 2)
  reason          String       @db.VarChar(1000)
  status          RefundStatus @default(REQUESTED)
  payeeName       String       @map("payee_name") @db.VarChar(300)
  bankName        String       @map("bank_name") @db.VarChar(150)
  accountNoEnc    String       @map("account_no_enc") @db.VarChar(500)
  accountNoMasked String       @map("account_no_masked") @db.VarChar(30)
  requestedById   String       @map("requested_by_id") @db.Uuid
  decidedById     String?      @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?    @map("decided_at") @db.Timestamptz(6)
  rejectReason    String?      @map("reject_reason") @db.VarChar(1000)
  paidById        String?      @map("paid_by_id") @db.Uuid
  paidAt          DateTime?    @map("paid_at") @db.Timestamptz(6)
  paidRef         String?      @map("paid_ref") @db.VarChar(100)
  version         Int          @default(1)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  order       PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requestedBy User         @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?        @relation("RefundDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status, createdAt])
  @@map("refunds")
}

/// Uploaded bank statement (CSV/XLSX) of a receiving account, for reconciliation (กระทบยอด).
/// Only credit (incoming) lines are imported; the same file cannot be uploaded twice per account.
model BankStatement {
  id             String   @id @default(uuid(7)) @db.Uuid
  statementNo    String   @unique @map("statement_no") @db.VarChar(30) // BS-2570-000001
  bankAccountId  String   @map("bank_account_id") @db.Uuid
  fileName       String   @map("file_name") @db.VarChar(300)
  fileSha256     String   @map("file_sha256") @db.Char(64)
  periodFrom     DateTime @map("period_from") @db.Timestamptz(6)
  periodTo       DateTime @map("period_to") @db.Timestamptz(6)
  /// Lines imported by this upload (lines already imported from an overlapping file are skipped).
  lineCount      Int      @map("line_count")
  duplicateCount Int      @default(0) @map("duplicate_count")
  totalCredit    Decimal  @map("total_credit") @db.Decimal(12, 2)
  uploadedById   String   @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bankAccount BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  uploadedBy  User                @relation("StatementUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  lines       BankStatementLine[]

  @@unique([bankAccountId, fileSha256])
  @@index([bankAccountId, periodFrom])
  @@map("bank_statements")
}

/// One credit line of a statement. Amount is immutable and lines are never deleted (trigger).
/// A payment backs at most one live match (partial unique on payment_id WHERE AUTO/MANUAL).
model BankStatementLine {
  id            String               @id @default(uuid(7)) @db.Uuid
  statementId   String               @map("statement_id") @db.Uuid
  bankAccountId String               @map("bank_account_id") @db.Uuid
  lineNo        Int                  @map("line_no")
  txnAt         DateTime             @map("txn_at") @db.Timestamptz(6)
  amount        Decimal              @db.Decimal(12, 2)
  description   String?              @db.VarChar(500)
  reference     String?              @db.VarChar(100)
  /// sha256(time|amount|reference|description|occurrence): one bank transaction is imported once per account.
  fingerprint   String               @db.Char(64)
  matchStatus   StatementMatchStatus @default(UNMATCHED) @map("match_status")
  paymentId     String?              @map("payment_id") @db.Uuid
  matchedById   String?              @map("matched_by_id") @db.Uuid
  matchedAt     DateTime?            @map("matched_at") @db.Timestamptz(6)
  note          String?              @db.VarChar(1000)
  version       Int                  @default(1)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  statement   BankStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)
  bankAccount BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  payment     Payment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  matchedBy   User?         @relation("StatementLineMatchedBy", fields: [matchedById], references: [id], onDelete: SetNull)

  @@unique([statementId, lineNo])
  @@unique([bankAccountId, fingerprint])
  @@index([bankAccountId, matchStatus, txnAt])
  @@index([paymentId])
  @@map("bank_statement_lines")
}
