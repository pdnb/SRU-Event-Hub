// ───────────────────────── Check-in, attendance & badges (P4, spec §4.8 / §4.8.1 / §4.9) ─────────────────────────

enum CheckinAction {
  CHECK_IN
  CHECK_OUT
  /// Reverses an earlier record (mis-scan); `undoes_id` points at it.
  UNDO
}

enum CheckinMethod {
  QR
  MANUAL
  GROUP
  /// Captured on a scanner device while offline and synced later.
  OFFLINE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum PersonnelRole {
  SPEAKER
  STAFF
  VIP
  ORGANIZER
  VOLUNTEER
  MEDIA
  OTHER
}

enum BadgePaper {
  /// Several badges laid out on A4 sheets (office printers).
  A4_SHEET
  /// One badge per page, page = badge size (card / label printers).
  LABEL
}

enum BadgePrintMode {
  BATCH
  INSTANT
  REPRINT
}

/// A check-in point (desk / entrance). Several points may run at once.
model CheckinLocation {
  id          String   @id @default(uuid(7)) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  nameTh      String   @map("name_th") @db.VarChar(200)
  /// Session this point checks people into by default (null = the whole event).
  scheduleId  String?  @map("schedule_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?  @map("created_by_id") @db.Uuid

  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  schedule EventSchedule?  @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  records  CheckinRecord[]

  @@unique([eventId, nameTh])
  @@map("checkin_locations")
}

/// QR credential of a registration (or of a whole group). The QR text is derived from the row id with
/// an HMAC (so it can be shown again at any time) and only its SHA-256 is stored. Re-issuing revokes
/// the old row. CHECK registration_id XOR group_id; one live token per registration / group (SQL).
model CheckinToken {
  id             String    @id @default(uuid(7)) @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  registrationId String?   @map("registration_id") @db.Uuid
  groupId        String?   @map("group_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedById    String?   @map("revoked_by_id") @db.Uuid
  revokeReason   String?   @map("revoke_reason") @db.VarChar(500)

  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration?      @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  group        RegistrationGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([groupId])
  @@map("checkin_tokens")
}

/// Every scan / manual check-in / undo. Append-only (trigger).
model CheckinRecord {
  id             String        @id @default(uuid(7)) @db.Uuid
  eventId        String        @map("event_id") @db.Uuid
  registrationId String        @map("registration_id") @db.Uuid
  locationId     String?       @map("location_id") @db.Uuid
  scheduleId     String?       @map("schedule_id") @db.Uuid
  action         CheckinAction
  method         CheckinMethod
  /// When it happened (device time for offline captures, never in the future).
  occurredAt     DateTime      @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  actorId        String?       @map("actor_id") @db.Uuid
  /// Client-generated key so retried / offline-synced captures are recorded once.
  clientKey      String?       @unique @map("client_key") @db.VarChar(64)
  undoesId       String?       @unique @map("undoes_id") @db.Uuid
  note           String?       @db.VarChar(500)

  event        Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration Registration     @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  location     CheckinLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  schedule     EventSchedule?   @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  actor        User?            @relation("CheckinActor", fields: [actorId], references: [id], onDelete: SetNull)
  undoes       CheckinRecord?   @relation("CheckinUndo", fields: [undoesId], references: [id], onDelete: Restrict)
  undoneBy     CheckinRecord?   @relation("CheckinUndo")

  @@index([eventId, createdAt])
  @@index([registrationId, occurredAt])
  @@map("checkin_records")
}

/// Attendance per registration: schedule_id NULL = the whole event, otherwise one session.
/// Derived from check-in records unless a staff member set it by hand (`is_manual`).
/// Unique (registration_id, schedule_id) NULLS NOT DISTINCT (SQL).
model AttendanceRecord {
  id             String           @id @default(uuid(7)) @db.Uuid
  eventId        String           @map("event_id") @db.Uuid
  registrationId String           @map("registration_id") @db.Uuid
  scheduleId     String?          @map("schedule_id") @db.Uuid
  status         AttendanceStatus
  firstCheckinAt DateTime?        @map("first_checkin_at") @db.Timestamptz(6)
  lastCheckoutAt DateTime?        @map("last_checkout_at") @db.Timestamptz(6)
  isManual       Boolean          @default(false) @map("is_manual")
  note           String?          @db.VarChar(500)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById    String?          @map("updated_by_id") @db.Uuid

  event        Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration Registration   @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  schedule     EventSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@unique([registrationId, scheduleId], map: "attendance_records_registration_schedule_key")
  @@index([eventId, scheduleId, status])
  @@map("attendance_records")
}

/// Speakers, staff, VIPs … who need a badge but do not register. `can_checkin` lets a linked user scan for this event.
model EventPersonnel {
  id          String        @id @default(uuid(7)) @db.Uuid
  eventId     String        @map("event_id") @db.Uuid
  userId      String?       @map("user_id") @db.Uuid
  role        PersonnelRole
  prefix      String?       @db.VarChar(50)
  firstName   String        @map("first_name") @db.VarChar(150)
  lastName    String        @map("last_name") @db.VarChar(150)
  position    String?       @db.VarChar(300)
  affiliation String?       @db.VarChar(300)
  email       String?       @db.VarChar(254)
  phone       String?       @db.VarChar(20)
  canCheckin  Boolean       @default(false) @map("can_checkin")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?       @map("created_by_id") @db.Uuid
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)

  event  Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User?        @relation("EventPersonnelUser", fields: [userId], references: [id], onDelete: SetNull)
  prints BadgePrint[]

  @@index([eventId])
  @@index([userId])
  @@map("event_personnel")
}

/// Badge layout designed per event. Sizes and positions are millimetres.
model BadgeTemplate {
  id               String     @id @default(uuid(7)) @db.Uuid
  eventId          String     @map("event_id") @db.Uuid
  nameTh           String     @map("name_th") @db.VarChar(200)
  paper            BadgePaper @default(A4_SHEET)
  widthMm          Float      @map("width_mm")
  heightMm         Float      @map("height_mm")
  backgroundColor  String?    @map("background_color") @db.VarChar(9)
  backgroundFileId String?    @map("background_file_id") @db.Uuid
  isDefault        Boolean    @default(false) @map("is_default")
  isActive         Boolean    @default(true) @map("is_active")
  version          Int        @default(1)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById      String?    @map("created_by_id") @db.Uuid
  updatedById      String?    @map("updated_by_id") @db.Uuid

  event      Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  background File?                @relation("BadgeBackground", fields: [backgroundFileId], references: [id], onDelete: SetNull)
  fields     BadgeTemplateField[]
  colorRules BadgeColorRule[]
  jobs       BadgePrintJob[]

  @@index([eventId])
  @@map("badge_templates")
}

model BadgeTemplateField {
  id         String  @id @default(uuid(7)) @db.Uuid
  templateId String  @map("template_id") @db.Uuid
  /// TEXT | QR | BAND (colour strip from the colour rules)
  kind       String  @db.VarChar(20)
  /// TEXT/BAND: text with {placeholders}; QR: ignored.
  content    String? @db.VarChar(500)
  xMm        Float   @map("x_mm")
  yMm        Float   @map("y_mm")
  wMm        Float   @map("w_mm")
  hMm        Float   @map("h_mm")
  fontSize   Float   @default(12) @map("font_size")
  bold       Boolean @default(false)
  align      String  @default("center") @db.VarChar(10)
  color      String? @db.VarChar(9)
  sortOrder  Int     @default(0) @map("sort_order")

  template BadgeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("badge_template_fields")
}

/// First matching rule decides a badge's colour band + label (e.g. participant type STUDENT → green "นักศึกษา").
model BadgeColorRule {
  id         String  @id @default(uuid(7)) @db.Uuid
  templateId String  @map("template_id") @db.Uuid
  /// PARTICIPANT_TYPE | PERSONNEL_ROLE | ANY
  matchType  String  @map("match_type") @db.VarChar(30)
  matchValue String? @map("match_value") @db.VarChar(50)
  color      String  @db.VarChar(9)
  label      String? @db.VarChar(100)
  sortOrder  Int     @default(0) @map("sort_order")

  template BadgeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("badge_color_rules")
}

/// One print request. The template is snapshotted so re-downloading renders the same badges.
model BadgePrintJob {
  id               String         @id @default(uuid(7)) @db.Uuid
  eventId          String         @map("event_id") @db.Uuid
  templateId       String         @map("template_id") @db.Uuid
  templateSnapshot Json           @map("template_snapshot")
  mode             BadgePrintMode
  itemCount        Int            @map("item_count")
  reason           String?        @db.VarChar(500)
  requestedById    String         @map("requested_by_id") @db.Uuid
  downloadCount    Int            @default(0) @map("download_count")
  lastDownloadedAt DateTime?      @map("last_downloaded_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  event       Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  template    BadgeTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  requestedBy User          @relation("BadgeJobRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  prints      BadgePrint[]

  @@index([eventId, createdAt])
  @@map("badge_print_jobs")
}

/// Each badge printed. print_no 1 = first print, 2+ = reprints. Append-only (trigger).
/// CHECK registration_id XOR personnel_id; unique (subject, print_no) blocks two desks printing the same badge twice.
model BadgePrint {
  id             String   @id @default(uuid(7)) @db.Uuid
  jobId          String   @map("job_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  registrationId String?  @map("registration_id") @db.Uuid
  personnelId    String?  @map("personnel_id") @db.Uuid
  printNo        Int      @map("print_no")
  sortOrder      Int      @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  job          BadgePrintJob   @relation(fields: [jobId], references: [id], onDelete: Restrict)
  registration Registration?   @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  personnel    EventPersonnel? @relation(fields: [personnelId], references: [id], onDelete: Restrict)

  @@unique([registrationId, printNo])
  @@unique([personnelId, printNo])
  @@index([jobId, sortOrder])
  @@index([eventId])
  @@map("badge_prints")
}
