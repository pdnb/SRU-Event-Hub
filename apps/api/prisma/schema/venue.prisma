// ───────────────────────── Venues & resources ─────────────────────────

enum VenueType {
  MEETING_ROOM
  LAB
  AUDITORIUM
  CLASSROOM
  OUTDOOR
  OTHER
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Building {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(30)
  nameTh    String   @map("name_th") @db.VarChar(300)
  campus    String?  @db.VarChar(200)
  address   String?  @db.VarChar(500)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  venues Venue[]

  @@map("buildings")
}

model Venue {
  id             String    @id @default(uuid(7)) @db.Uuid
  buildingId     String?   @map("building_id") @db.Uuid
  code           String    @unique @db.VarChar(30)
  nameTh         String    @map("name_th") @db.VarChar(300)
  venueType      VenueType @map("venue_type")
  capacity       Int?
  floor          String?   @db.VarChar(20)
  description    String?   @db.VarChar(2000)
  /// Unit that manages (approves bookings of) this venue; null = central (needs venue:approve with ALL scope).
  organizationId String?   @map("organization_id") @db.Uuid
  /// Bookings are approved automatically when free (e.g. a faculty's own meeting room).
  autoApprove    Boolean   @default(false) @map("auto_approve")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  building     Building?      @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  organization Organization?  @relation("VenueManager", fields: [organizationId], references: [id], onDelete: Restrict)
  events       Event[]
  bookings     VenueBooking[]
  resources    Resource[]

  @@index([buildingId])
  @@index([organizationId])
  @@map("venues")
}

model Resource {
  id             String   @id @default(uuid(7)) @db.Uuid
  code           String   @unique @db.VarChar(30)
  nameTh         String   @map("name_th") @db.VarChar(300)
  resourceType   String   @map("resource_type") @db.VarChar(100)
  quantity       Int      @default(1)
  /// Unit that lends this item; null = central.
  organizationId String?  @map("organization_id") @db.Uuid
  description    String?  @db.VarChar(1000)
  /// Fixed equipment installed in a venue (projector in room X); null = movable.
  venueId        String?  @map("venue_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue        Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  organization Organization?     @relation("ResourceManager", fields: [organizationId], references: [id], onDelete: Restrict)
  bookings     ResourceBooking[]

  @@map("resources")
}

/// Overlapping APPROVED bookings of the same venue are rejected by an
/// exclusion constraint (btree_gist + tstzrange) – see migration SQL.
model VenueBooking {
  id            String        @id @default(uuid(7)) @db.Uuid
  venueId       String        @map("venue_id") @db.Uuid
  eventId       String?       @map("event_id") @db.Uuid
  startAt       DateTime      @map("start_at") @db.Timestamptz(6)
  endAt         DateTime      @map("end_at") @db.Timestamptz(6)
  status        BookingStatus @default(PENDING)
  purpose       String?       @db.VarChar(1000)
  requestedById String        @map("requested_by_id") @db.Uuid
  decidedById   String?       @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?     @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?       @map("decision_note") @db.VarChar(1000)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue       Venue  @relation(fields: [venueId], references: [id], onDelete: Restrict)
  event       Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  requestedBy User   @relation("BookingRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?  @relation("BookingApprover", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([venueId, startAt])
  @@index([eventId])
  @@map("venue_bookings")
}

/// Approved quantities of one item may never exceed its stock at any instant (checked under a row lock on the resource).
model ResourceBooking {
  id            String        @id @default(uuid(7)) @db.Uuid
  resourceId    String        @map("resource_id") @db.Uuid
  eventId       String?       @map("event_id") @db.Uuid
  quantity      Int           @default(1)
  startAt       DateTime      @map("start_at") @db.Timestamptz(6)
  endAt         DateTime      @map("end_at") @db.Timestamptz(6)
  status        BookingStatus @default(PENDING)
  purpose       String?       @db.VarChar(1000)
  requestedById String?       @map("requested_by_id") @db.Uuid
  decidedById   String?       @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?     @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?       @map("decision_note") @db.VarChar(1000)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  requestedBy User?    @relation("ResourceBookingRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User?    @relation("ResourceBookingApprover", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([resourceId, startAt])
  @@index([eventId])
  @@map("resource_bookings")
}
