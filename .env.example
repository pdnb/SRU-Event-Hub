# ─── Copy to .env (root, used by docker compose) and apps/api/.env ───
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=sru
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sru_event_hub
DATABASE_URL=postgresql://sru:change-me-local-only@localhost:5432/sru_event_hub?schema=public

# Redis (BullMQ, cache, rate limiting)
# Host port mapping (change if 6379 is taken locally)
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Behind Nginx set to 1 so req.ip reflects the client
TRUST_PROXY=0

# JWT – generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=14
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Field-level encryption (AES-256-GCM) – 32 bytes base64. Load from a secret manager in production.
FIELD_ENCRYPTION_KEY=

# Google OAuth 2.0 / OIDC (leave empty to disable). Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
# Only accounts from these domains may sign in with Google (comma separated)
GOOGLE_ALLOWED_DOMAINS=sru.ac.th

# S3-compatible object storage (SeaweedFS locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=sru-app
S3_SECRET_KEY=change-me-local-only
S3_BUCKET_PUBLIC=sru-public
S3_BUCKET_PRIVATE=sru-private
S3_FORCE_PATH_STYLE=true

# Payments
# Max payment-slip upload size in bytes (JPG/PNG/PDF, verified by magic number)
SLIP_MAX_BYTES=5000000
# BullMQ workers (payment expiry). false only in automated tests.
QUEUE_ENABLED=true

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Demo seed password; leave empty to generate one
SEED_DEMO=true
SEED_DEMO_PASSWORD=
